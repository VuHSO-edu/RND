# ==========================================
# CẤU HÌNH MÔI TRƯỜNG CHO UBUNTU SERVER (PRODUCTION)
# Đổi tên tệp này thành .env trên server: cp .env.example .env
# ==========================================

# 1. Tên Miền hoặc IP công khai của Server (VD: heritage.vn hoặc 103.123.45.67)
PUBLIC_DOMAIN_OR_IP=localhost

# 2. Cấu hình Cơ sở dữ liệu PostgreSQL PostGIS
POSTGRES_DB=heritagedb
POSTGRES_USER=heritage_user
POSTGRES_PASSWORD=HeritagePassword@2026

# 3. Cấu hình Kho lưu trữ MinIO S3
MINIO_ROOT_USER=heritage_admin
MINIO_ROOT_PASSWORD=HeritageMinio@2026
MINIO_BUCKET_NAME=heritage-media

# 4. Khóa bí mật JWT (Thay bằng chuỗi ngẫu nhiên dài >= 64 ký tự khi lên production)
JWT_SECRET=heritageSecretKeyForDevMustBeAtLeast256BitsLongForHMACSHA256SignatureSecurity
